{
  "rule": [
    {
      "action": {"type": "Delete"},
      "condition": {"age": 1, "matchesPrefix": ["uploads/"]}
    },
    {
      "action": {"type": "SetStorageClass", "storageClass": "ARCHIVE"},
      "condition": {
        "age": 90,
        "matchesPrefix": ["display/", "thumbs/"],
        "matchesStorageClass": ["STANDARD"]
      }
    }
  ]
}