# Local development settings. Copy to flask_server/.env (which git ignores);
# `pipenv run` and `pipenv shell` load it automatically.

# Lets `import shared.matching` find ../shared without copying it in
PYTHONPATH=..

# Use the Firebase emulators (`firebase emulators:start` from the repo root), never real data
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# React runs on another port locally, so the API must allow it
ALLOWED_ORIGINS=http://localhost:3000

# Keep uploads on disk (instance/dev_storage) instead of the real buckets
STORAGE_MODE=local

# Your email, so you can use the admin page locally
ADMIN_EMAILS=you@example.com
