REACT_APP_FIREBASE_AUTH_DOMAIN=secret-santa-511801.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=secret-santa-511801
REACT_APP_FIREBASE_APP_ID=1:31757378870:web:e28febc4d7551a51c67f97

# Sign in against the local Auth emulator (port 9099), which Flask also uses in development
